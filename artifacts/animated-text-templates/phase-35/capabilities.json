{
  "schemaVersion": 1,
  "maxLayers": 16,
  "maxTextSlots": 8,
  "maxGraphemesPerSlot": 512,
  "maxRepairIterations": 5,
  "supportedLayerTypes": [
    "Text",
    "Shape",
    "Image"
  ],
  "supportedShapeKinds": [
    "Rectangle",
    "RoundedRectangle",
    "Ellipse",
    "Circle",
    "Line"
  ],
  "supportedParameterTypes": [
    "Text",
    "Color",
    "Number",
    "Boolean",
    "Enum"
  ],
  "supportedPropertyPaths": [
    "TextContent",
    "FontColor",
    "FontSize",
    "FontFamily",
    "BackgroundColor",
    "PositionX",
    "PositionY",
    "ScaleX",
    "ScaleY",
    "Rotation",
    "Opacity",
    "FillColor",
    "StrokeColor",
    "StrokeWidth",
    "CornerRadius",
    "Width",
    "Height",
    "Visible"
  ],
  "supportedAnimationPresets": [
    "FadeIn",
    "FadeOut",
    "SlideInLeft",
    "SlideInRight",
    "PopIn",
    "Typewriter",
    "Wiggle",
    "Pulse"
  ],
  "supportedAnimationUnits": [
    "All",
    "Grapheme",
    "Word",
    "Line"
  ],
  "supportedStaggerOrders": [
    "Forward",
    "Backward",
    "CenterOut",
    "Random"
  ],
  "supportedLoopModes": [
    "None",
    "Repeat",
    "PingPong"
  ],
  "supportedDurationConflictPolicies": [
    "Reject",
    "ProportionalScale",
    "ClampOut"
  ],
  "supportedUnits": [
    "pixels",
    "normalized_0_1",
    "degrees",
    "rational_time",
    "seconds",
    "hex_color_#RRGGBB_#RRGGBBAA"
  ],
  "builtInPrimitives": [
    "headline-bold",
    "subtle-lower-third",
    "retro-neon",
    "cyber-frame",
    "minimal-clean",
    "speech-bubble",
    "tag-pill",
    "split-accent",
    "gradient-wave",
    "typewriter-box",
    "card-slide",
    "quote-frame"
  ],
  "draftJsonSchema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "bindings": {
        "items": {
          "type": "object"
        },
        "type": "array"
      },
      "category": {
        "minLength": 1,
        "type": "string"
      },
      "defaultDuration": {
        "type": "object"
      },
      "description": {
        "type": "string"
      },
      "draftId": {
        "type": "string"
      },
      "layers": {
        "items": {
          "type": "object"
        },
        "maxItems": 16,
        "minItems": 1,
        "type": "array"
      },
      "name": {
        "minLength": 1,
        "type": "string"
      },
      "parameters": {
        "items": {
          "type": "object"
        },
        "type": "array"
      },
      "provenance": {
        "additionalProperties": false,
        "properties": {
          "agentId": {
            "type": "string"
          },
          "agentVersion": {
            "type": "string"
          },
          "authorType": {
            "enum": [
              "agent",
              "user",
              "import"
            ],
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "iteration": {
            "maximum": 5,
            "minimum": 1,
            "type": "integer"
          },
          "parentDraftId": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "referenceSummary": {
            "type": "string"
          },
          "requiredMissingResources": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "unsupportedApproximations": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "required": [
          "authorType"
        ],
        "type": "object"
      },
      "resources": {
        "properties": {
          "resources": {
            "items": {
              "type": "object"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "responsivePolicy": {
        "type": "object"
      },
      "schemaVersion": {
        "const": 1,
        "type": "integer"
      },
      "slots": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "description": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "required": {
              "type": "boolean"
            },
            "slotKey": {
              "type": "string"
            },
            "slotType": {
              "enum": [
                "text",
                "image",
                "shape"
              ],
              "type": "string"
            }
          },
          "required": [
            "slotKey",
            "name",
            "slotType"
          ],
          "type": "object"
        },
        "type": "array"
      },
      "tags": {
        "items": {
          "type": "string"
        },
        "type": "array"
      },
      "templateId": {
        "pattern": "^[a-zA-Z0-9_-]+$",
        "type": "string"
      },
      "templateVersion": {
        "minimum": 1,
        "type": "integer"
      },
      "userOverrides": {
        "items": {
          "type": "object"
        },
        "type": "array"
      }
    },
    "required": [
      "draftId",
      "templateId",
      "name",
      "category",
      "description",
      "layers",
      "provenance"
    ],
    "title": "TinixCutTemplateDraft",
    "type": "object"
  }
}